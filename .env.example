# Copy to `.env.local` and fill in. Vite only exposes vars prefixed with VITE_.

# WebSocket endpoint of the (foreign) backend. Use wss:// in production.
VITE_WS_URL=wss://your-backend.example/ws

# Dev only: set to 1 to serve local mock data (src/mocks) instead of a real
# backend — no VITE_WS_URL needed. Leave unset/0 to use the real socket.
VITE_MOCK=0
